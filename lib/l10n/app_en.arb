  "publicationJune2013": "June 3, 2013: End of French translation",
  "publicationJune2013P1": "On Monday, June 3, 2013, the 23rd anniversary of Shekinah Tabernacle, the translators of Shekinah Publications solemnly handed over the last translated sermon — \"The Confused Sound,\" preached in Jeffersonville on December 18, 1960 — to the Reverend Pastor Richard Diyoka, at Bethany Village.",
  "publicationJune2013P2": "The Bride in the French-speaking world thus has the complete collection of sermons translated into French preached by the prophet of God William Marrion Branham. This day marked the completion of 17 years of translation work.",
  "publicationLabel": "Shekinah Publications",
  "publicationMessageForAge": "The Message for this age",
  "publicationMessageForAgeP1": "The Reverend William Marrion Branham, whom Almighty God confirmed as the prophet of God for our generation, received from the Lord a Message for this age, contained in roughly 1200 sermons recorded on magnetic tapes.",
  "publicationMessageForAgeP2": "This Message was to be translated into several languages and spread throughout the world, for the edification of the Church and the preparation of the Bride of the Lord Jesus Christ. Shekinah Missions is convinced that this Message is the Gospel of the Lord Jesus Christ for this end time.",
  "publicationMissionSummary": "Translation, printing, and free distribution of the end-time Message worldwide, for the edification of the Church.",
  "publicationOurMission": "Our mission",
  "publicationOurMissionP1": "Shekinah Missions has taken on the task of spreading this Good News of the Kingdom by translating the Message into national and international languages, and by preaching and teaching the Word of God according to the end-time Message and the Bible (Ephesians chapter 4).",
  "publicationOurMissionP2": "Shekinah Missions receives requests for sermons by the prophet of God, William Marrion Branham, and responds by sending these sermons free of charge. 60 countries around the world are served.",
  "publicationScriptureQuote": "« Praise the Lord, call on his name! Make known his deeds among the peoples! »",
  "publicationScriptureRef": "Psalm 105:1",
  "publicationTagline": "Missionary work for the Bride of Christ",
  "publicationTitle": "Shekinah Publication",
